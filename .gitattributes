# Normalise line endings
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.zip binary

# Bundled third-party code: don't count it as this project's language, don't diff it
assets/vendor/** linguist-vendored
assets/vendor/**/*.js -diff

# Keep GitHub's "Download ZIP" / git archive free of dev-only files
/.gitattributes export-ignore
/.gitignore export-ignore
/.distignore export-ignore
/bin export-ignore
/docs export-ignore
/tests export-ignore
